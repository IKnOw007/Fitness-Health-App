# ---------------------------------------------------------------------------
# PulseFit backend configuration
# Copy to .env and adjust before deploying.
# ---------------------------------------------------------------------------

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Set to "true" when your managed Postgres requires TLS (Neon, RDS, Supabase...)
DATABASE_SSL=false

# Build / release metadata surfaced on /api/version
APP_VERSION=1.0.0
GIT_SHA=local

# Comma separated list of allowed browser origins. Empty = reflect any origin.
# Example: https://app.pulsefit.io,https://admin.pulsefit.io
CORS_ALLOWED_ORIGINS=

# Rate limiting (per endpoint, per caller)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
RATE_LIMIT_AUTH_MAX=12

# Bearer token lifetime in days
AUTH_TOKEN_TTL_DAYS=30

# When true, unauthenticated API calls resolve to the seeded demo account.
# ALWAYS set to false for a real production deployment.
DEMO_MODE=true
DEMO_EMAIL=demo@pulsefit.app
DEMO_PASSWORD=pulsefit123

# API pagination
API_DEFAULT_PAGE_SIZE=25
API_MAX_PAGE_SIZE=100

# Set to "off" to silence structured request logs
API_LOGGING=on
